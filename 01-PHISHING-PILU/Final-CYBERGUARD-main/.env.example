# ==============================================================================
# CYBERGUARD — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and adjust variables as needed. Do NOT commit real secrets to Git.
# ==============================================================================

# Server Network Configuration
CYBERGUARD_HOST=127.0.0.1
CYBERGUARD_PORT=8000

# Backend API Base URL (Used by client / frontend when accessed remotely)
API_BASE_URL=http://127.0.0.1:8000

# Model Device Configuration ('cpu' or 'cuda')
CYBERGUARD_DEVICE=cpu

# Log Level ('info', 'debug', 'warning', 'error')
CYBERGUARD_LOG_LEVEL=info
