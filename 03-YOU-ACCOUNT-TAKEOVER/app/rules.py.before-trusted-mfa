from datetime import datetime, timezone
from zoneinfo import ZoneInfo


# ============================================================
# TIMEZONE CONFIGURATION
# ============================================================

IST = ZoneInfo("Asia/Kolkata")


def get_local_login_hour(timestamp):
    """
    Convert the supplied timestamp to India Standard Time (IST)
    and return the local login hour.

    CyberGuard's backend may provide a naive UTC timestamp.
    In that case, it is explicitly treated as UTC before
    conversion to IST.

    If the timestamp is already timezone-aware, its existing
    timezone information is respected.
    """

    # --------------------------------------------------------
    # Handle naive timestamps
    # --------------------------------------------------------

    if timestamp.tzinfo is None:

        timestamp = timestamp.replace(
            tzinfo=timezone.utc
        )

    # --------------------------------------------------------
    # Convert timestamp to IST
    # --------------------------------------------------------

    local_timestamp = timestamp.astimezone(
        IST
    )

    return local_timestamp.hour


# ============================================================
# LOGIN RULE EVALUATION
# ============================================================

def evaluate_login_rules(
    user,
    ip_address,
    location,
    device_id,
    timestamp,
    failed_attempts,
    is_new_device=False,
    is_new_ip=False
):
    """
    CyberGuard Account Takeover Detection Rule Engine.

    This function analyzes:

        - New device
        - New IP address
        - Unusual location
        - Unusual login time
        - Failed login attempts

    Returns:

        rule_score
        indicators
    """

    score = 0

    indicators = []


    # ========================================================
    # 1. NEW / UNKNOWN DEVICE
    # ========================================================

    if is_new_device:

        score += 20

        indicators.append(
            "Login from a new or unknown device"
        )


    # ========================================================
    # 2. NEW IP ADDRESS
    # ========================================================

    if is_new_ip:

        score += 15

        indicators.append(
            "Login from a new IP address"
        )


    # ========================================================
    # 3. UNUSUAL LOCATION
    # ========================================================

    # Try to get the user's normal/home location.
    # This is written safely so the API will not crash
    # if the database does not contain home_location.

    try:

        home_location = user["home_location"]

    except (KeyError, IndexError):

        home_location = None


    if home_location:

        if (
            location.lower()
            != str(home_location).lower()
        ):

            score += 20

            indicators.append(
                "Login from an unusual location"
            )


    # ========================================================
    # 4. UNUSUAL LOGIN TIME
    # ========================================================

    # Convert the backend timestamp to IST before evaluating
    # the user's normal login window.

    login_hour = get_local_login_hour(
        timestamp
    )


    # --------------------------------------------------------
    # Default normal login window
    # --------------------------------------------------------

    normal_start = 6

    normal_end = 22


    # --------------------------------------------------------
    # Use user's custom login hours when available
    # --------------------------------------------------------

    try:

        if user["usual_login_start"] is not None:

            normal_start = int(
                user["usual_login_start"]
            )

    except (
        KeyError,
        IndexError,
        TypeError,
        ValueError
    ):

        pass


    try:

        if user["usual_login_end"] is not None:

            normal_end = int(
                user["usual_login_end"]
            )

    except (
        KeyError,
        IndexError,
        TypeError,
        ValueError
    ):

        pass


    # --------------------------------------------------------
    # Check login time
    # --------------------------------------------------------

    if not (
        normal_start
        <= login_hour
        <= normal_end
    ):

        score += 15

        indicators.append(
            "Login occurred outside the user's normal login hours"
        )


    # ========================================================
    # 5. RECENT FAILED LOGIN ATTEMPTS
    # ========================================================

    if failed_attempts >= 3:

        score += 15

        indicators.append(
            f"{failed_attempts} recent failed login attempts detected"
        )


    # ========================================================
    # 6. MULTIPLE FAILED ATTEMPTS
    # ========================================================

    if failed_attempts >= 5:

        score += 15

        indicators.append(
            "Multiple consecutive authentication failures"
        )


    # ========================================================
    # LIMIT SCORE
    # ========================================================

    score = min(
        score,
        100
    )


    # ========================================================
    # RETURN RESULT
    # ========================================================

    return score, indicators