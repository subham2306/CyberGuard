# ============================================================
# SAVE THREAT EVENT
# ============================================================

def save_threat_event(
    scenario,
    result,
    payload
):

    # --------------------------------------------------------
    # CLASSIFY EVENT BASED ON DEMO SCENARIO
    # --------------------------------------------------------

    scenario_threat_types = {

        "normal": "normal_login",

        "suspicious": "suspicious_login",

        "ato": "account_takeover"

    }

    threat_type = scenario_threat_types.get(

        scenario,

        result.get(
            "threat_type",
            "account_takeover"
        )

    )


    # --------------------------------------------------------
    # EXTRACT USEFUL INFORMATION FROM REAL FASTAPI RESPONSE
    # --------------------------------------------------------

    event = {

        "timestamp":
            datetime.now()
            .astimezone()
            .isoformat(),

        "scenario":
            scenario,

        "event_id":
            result.get(
                "event_id",
                "N/A"
            ),

        "threat_type":
            threat_type,

        "username":
            payload.get(
                "username",
                "unknown"
            ),

        "ip_address":
            payload.get(
                "ip_address",
                "unknown"
            ),

        "location":
            payload.get(
                "location",
                "unknown"
            ),

        "device_id":
            payload.get(
                "device_id",
                "unknown"
            ),

        "risk_score":
            result.get(
                "risk_score",
                0
            ),

        "severity":
            result.get(
                "severity",
                "Unknown"
            ),

        "decision":
            result.get(
                "decision",
                "UNKNOWN"
            ),

        "login":
            result.get(
                "login",
                "unknown"
            ),

        "indicators":
            result.get(
                "indicators",
                []
            ),

        "explanation":
            result.get(
                "explanation",
                ""
            ),

        "recommended_actions":
            result.get(
                "recommended_actions",
                []
            ),

        "ml_detection":
            result.get(
                "ml_detection",
                {}
            ),

        "rule_detection":
            result.get(
                "rule_detection",
                {}
            ),

        "password_spraying":
            result.get(
                "password_spraying",
                {}
            ),

        "session":
            result.get(
                "session",
                {}
            )

    }


    # --------------------------------------------------------
    # NEWEST EVENTS APPEAR FIRST
    # --------------------------------------------------------

    THREAT_EVENTS.insert(
        0,
        event
    )


    # --------------------------------------------------------
    # KEEP ONLY THE LATEST 50 EVENTS
    # --------------------------------------------------------

    del THREAT_EVENTS[MAX_EVENTS:]


# ============================================================
# LIVE THREAT SIMULATION
# ============================================================

@app.route(
    "/api/simulate",
    methods=["POST"]
)
def simulate():

    try:

        data = request.get_json(
            silent=True
        ) or {}


        scenario = data.get(
            "scenario",
            "normal"
        )


        # ====================================================
        # DEMO SCENARIOS
        # ====================================================

        scenarios = {


            # =================================================
            # 1. NORMAL LOGIN
            # =================================================

            "normal": {

                "username":
                    "alice",

                "password":
                    "Alice@123",

                "ip_address":
                    "192.0.2.10",

                "location":
                    "Bhubaneswar",

                "device_id":
                    "DEV001",

                "user_agent":
                    "CyberGuard-Demo-Client"

            },


            # =================================================
            # 2. SUSPICIOUS LOGIN
            # =================================================

            "suspicious": {

                "username":
                    "alice",

                "password":
                    "Alice@123",

                "ip_address":
                    "198.51.100.25",

                "location":
                    "Delhi",

                "device_id":
                    "NEW-DEVICE-001",

                "user_agent":
                    "CyberGuard-Demo-Client"

            },


            # =================================================
            # 3. ACCOUNT TAKEOVER
            # =================================================

            "ato": {

                "username":
                    "alice",

                "password":
                    "WrongPassword@999",

                "ip_address":
                    "203.0.113.50",

                "location":
                    "Delhi",

                "device_id":
                    "UNKNOWN-ATTACKER-001",

                "user_agent":
                    "Unknown-Attacker-Agent"

            }

        }


        # ====================================================
        # VALIDATE SCENARIO
        # ====================================================

        payload = scenarios.get(
            scenario
        )


        if payload is None:

            return jsonify({

                "error":
                    "Invalid simulation scenario",

                "available_scenarios": [

                    "normal",

                    "suspicious",

                    "ato"

                ]

            }), 400


        # ====================================================
        # SEND REQUEST TO REAL ATO ENGINE
        # ====================================================

        response = requests.post(

            f"{ATO_API}/login",

            json=payload,

            timeout=5

        )


        result = response.json()


        # ====================================================
        # SAVE REAL RESULT TO EVENT LOG
        # ====================================================

        save_threat_event(

            scenario,

            result,

            payload

        )


        # ====================================================
        # RETURN REAL ATO RESPONSE
        # ====================================================

        return jsonify(
            result
        ), response.status_code


    # ========================================================
    # ATO API CONNECTION ERROR
    # ========================================================

    except requests.exceptions.ConnectionError:

        return jsonify({

            "error":
                "ATO API is offline. Start the FastAPI server on port 8000."

        }), 503


    # ========================================================
    # ATO API TIMEOUT
    # ========================================================

    except requests.exceptions.Timeout:

        return jsonify({

            "error":
                "ATO API request timed out."

        }), 504


    # ========================================================
    # GENERAL ERROR
    # ========================================================

    except Exception as e:

        return jsonify({

            "error":
                str(e)

        }), 500


