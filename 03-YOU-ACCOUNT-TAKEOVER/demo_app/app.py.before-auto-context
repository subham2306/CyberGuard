# ============================================================
# USER LOGIN API PROXY
# ============================================================

@app.route(
    "/api/login",
    methods=["POST"]
)
def user_login():

    try:

        data = request.get_json(
            silent=True
        ) or {}

        # Send the user's login request to the real
        # FastAPI ATO detection engine.
        response = requests.post(
            f"{ATO_API}/login",
            json=data,
            timeout=5
        )

        return jsonify(
            response.json()
        ), response.status_code

    except requests.exceptions.ConnectionError:

        return jsonify({
            "error":
                "ATO API is offline. Start the FastAPI server on port 8000."
        }), 503

    except requests.exceptions.Timeout:

        return jsonify({
            "error":
                "ATO API request timed out."
        }), 504

    except Exception as e:

        return jsonify({
            "error":
                str(e)
        }), 500


